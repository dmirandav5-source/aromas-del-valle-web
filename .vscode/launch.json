{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Desarrollo (Vite + API)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Producción (build + npm start)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build && npm start",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "servidor en (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Pruebas (Vitest)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test",
      "cwd": "${workspaceFolder}"
    }
  ]
}
